# Environment Configuration
NODE_ENV=development

# Service Ports
PORT_LEGACY=3001
PORT_GATEWAY=3000
PORT_CREDIT=3002
PORT_DISBURSEMENT=3003
PORT_LOAN=3004
PORT_WEB=5173

# Gateway Routing Target Defaults
LEGACY_SERVICE_URL=http://localhost:3001
CREDIT_SERVICE_URL=http://localhost:3002
DISBURSEMENT_SERVICE_URL=http://localhost:3003
LOAN_SERVICE_URL=http://localhost:3004

# Message Broker (RabbitMQ)
RABBITMQ_URL=amqp://guest:guest@localhost:5672
RABBITMQ_EXCHANGE=lendstrangler.topic
USE_IN_MEMORY_BROKER=false

# Chaos / Fault Injection (0.0 to 1.0 probability)
DISBURSEMENT_CHAOS_FAILURE_RATE=0.0

# Frontend Web configuration
VITE_DEMO_MODE=true
VITE_GATEWAY_URL=http://localhost:3000
